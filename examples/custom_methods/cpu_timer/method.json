{
  "contract_version": "custom-method-v1",
  "descriptor": {
    "name": "cpu-call-timer",
    "version": "1.0.0",
    "kind": "measurement",
    "entrypoint": "timer:run",
    "parameters_schema": {
      "type": "object",
      "properties": {
        "warmup": {"type": "integer", "minimum": 0, "maximum": 100, "default": 1},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 100, "default": 3},
        "iterations": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 1000},
        "aggregation": {"type": "string", "enum": ["mean", "median"], "default": "mean"}
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": ["metric", "unit", "value", "samples", "aggregation", "calls", "checksum"],
      "properties": {
        "metric": {"const": "cpu_call_wall_time"},
        "unit": {"const": "ns"},
        "value": {"type": "number", "minimum": 0},
        "samples": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "calls": {"type": "integer", "minimum": 1}
      }
    },
    "output_artifacts": {"timing.json": {"required": true, "media_type": "application/json"}}
  },
  "files": ["timer.py", "target.py"]
}
