# Host launcher settings. Compose uses deploy/compose/.env.example.
ASCEND_OP_EVAL_REDIS_URL=redis://127.0.0.1:6379/7
ASCEND_OP_EVAL_REDIS_PREFIX=triton-eval:v2.1
# Bump after changing the hardware/runtime used for Torch baseline timings.
ASCEND_OP_EVAL_BASELINE_CACHE_NAMESPACE=torch-baseline-v1
ASCEND_OP_EVAL_API_HOST=10.0.0.11
ASCEND_OP_EVAL_API_PORT=11907
ASCEND_OP_EVAL_CARDS=0,1,2,3
ASCEND_OP_EVAL_CPU_WORKERS=1
ASCEND_OP_EVAL_DEVICE_HOLD_MB=64
ASCEND_OP_EVAL_CAPABILITY_SECRET_PATH=/run/secrets/ascend-op-eval
ASCEND_OP_EVAL_EVALUATOR_BUILD=git:<40-lowercase-hex>
# Release identity. release mode verifies the installed sources, dependencies
# and build against this manifest and refuses to start otherwise; generate it
# with scripts/release_manifest.py and bind the same build identity.
ASCEND_OP_EVAL_RELEASE_MODE=release
ASCEND_OP_EVAL_RELEASE_MANIFEST=/srv/ascend-op-eval/release-manifest.json
ASCEND_OP_EVAL_REFERENCE_DEVICE_POLICY=cpu-first
# Optional operator-only observations, retained outside candidate attempts.
# ASCEND_OP_EVAL_REFERENCE_DIAGNOSTICS_DIR=/srv/ascend-op-eval/reference-diagnostics
ASCEND_OP_EVAL_RETENTION_SECONDS=604800
ASCEND_OP_EVAL_MAX_RECOVERY_AGE_SECONDS=86400
# Whole-run caps; the admitted request deadline still bounds all stages together.
ASCEND_OP_EVAL_VERIFY_BUDGET_CAP_SECONDS=3600
ASCEND_OP_EVAL_BENCHMARK_TIMEOUT_SECONDS=3600
# Populate from the deployed toolchain; empty disables verdict reuse.
ASCEND_OP_EVAL_CANN_FINGERPRINT=
CANN_SET_ENV_PATH=/usr/local/Ascend/ascend-toolkit/set_env.sh
# PYTHON_BIN=/path/to/venv/bin/python3
LOG_DIR=logs
MSPROF_BIN=msprof
MSPROF_TIMEOUT_SEC=300
MSPROF_DISCOVERY_TIMEOUT_SEC=900
