# Docker env-file for the A3 instance. Docker reads values literally.
ASCEND_OP_EVAL_REDIS_URL=redis://127.0.0.1:6391/7
ASCEND_OP_EVAL_REDIS_PREFIX=triton-eval:v2.1
ASCEND_OP_EVAL_API_HOST=80.5.5.102
ASCEND_OP_EVAL_API_PORT=11907
ASCEND_OP_EVAL_CARDS=0,1,3,4
ASCEND_OP_EVAL_CPU_WORKERS=1
ASCEND_OP_EVAL_DEVICE_HOLD_MB=64
ASCEND_OP_EVAL_TRIAL_MAX_INFLIGHT=12
ASCEND_OP_EVAL_SESSION_MAX_INFLIGHT=12
ASCEND_OP_EVAL_REFERENCE_DEVICE_POLICY=cpu-first
ASCEND_OP_EVAL_METHOD_CAPABILITIES=["python","npu","process-isolation","soc-ascend910_93"]
ASCEND_OP_EVAL_WORKER_HARDWARE_MODEL=Ascend910B1
ASCEND_OP_EVAL_WORKER_DRIVER_VERSION=26.1.1
ASCEND_OP_EVAL_WORKER_RUNTIME_VERSION=CANN-9.2.0
# Bind the qualified CANN installation directly rather than a compatibility symlink.
CANN_SET_ENV_PATH=/opt/cann/cann-9.2.0/set_env.sh
ASCEND_DRIVER_PATH=/usr/local/Ascend/driver
