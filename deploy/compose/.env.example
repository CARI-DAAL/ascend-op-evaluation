# New installations only. Upgrades must use the actual existing Compose project name.
ASCEND_OP_EVAL_COMPOSE_PROJECT_NAME=ascend-op-eval
# Deploy-time settings for docker compose (pass with: --env-file deploy/compose/.env).
# Copy to deploy/compose/.env and adjust. Startup goes through deploy/compose/compose.sh +
# scripts/deployment_preflight.py.

# --- NPU chip(s) ---
# Physical card ids, comma-separated. One worker is pinned to each listed card.
ASCEND_OP_EVAL_CARDS=0,1,2,3
# Compile-only capacity. Mixed checks execute entirely on an NPU worker.
# 0 disables compile-only submissions until another CPU worker joins this instance.
ASCEND_OP_EVAL_CPU_WORKERS=1

# --- Redis (host, via --network host) ---
ASCEND_OP_EVAL_REDIS_URL=redis://127.0.0.1:6379/7

# --- API ---
ASCEND_OP_EVAL_API_PORT=11907
ASCEND_OP_EVAL_API_HOST=10.0.0.11
# Each host uses its own Redis; never share card IDs in one Redis namespace.
ASCEND_OP_EVAL_REDIS_PREFIX=triton-eval:v2.1
# Bump after changing the hardware/runtime used for Torch baseline timings.
ASCEND_OP_EVAL_BASELINE_CACHE_NAMESPACE=torch-baseline-v1

# --- Immutable images (REQUIRED, no tag-only defaults) ---
ASCEND_OP_EVAL_IMAGE=registry.example.com/ascend-op-eval@sha256:<64-lowercase-hex>
# Copy the same digest without the registry/name prefix.
ASCEND_OP_EVAL_EVALUATOR_BUILD=sha256:<64-lowercase-hex>
# Release manifest for exactly this image, generated after the build with
# scripts/release_manifest.py and bound to the digest above. Mounted read-only.
ASCEND_OP_EVAL_RELEASE_MANIFEST_HOST=/srv/ascend-op-eval/release-manifest.json
ASCEND_OP_EVAL_REFERENCE_DEVICE_POLICY=cpu-first

# --- Engine whole-run budgets ---
# The admitted request deadline still bounds all stages together.
ASCEND_OP_EVAL_VERIFY_BUDGET_CAP_SECONDS=3600
ASCEND_OP_EVAL_BENCHMARK_TIMEOUT_SECONDS=3600

# --- Caller capabilities (mounted read-only) ---
ASCEND_OP_EVAL_CAPABILITY_SECRET_PATH=/srv/ascend-op-eval-secrets/triton-eval.json

# Host CANN root (mounted read-only at /opt/cann). Python comes from the image.
CANN_HOST=/usr/local/Ascend

# Worker provenance declarations. Replace these example values with the actual
# host hardware, driver, runtime and toolchain inventory before deployment.
ASCEND_OP_EVAL_WORKER_HARDWARE_MODEL=Ascend910
ASCEND_OP_EVAL_WORKER_DRIVER_VERSION=26.0.rc1
ASCEND_OP_EVAL_WORKER_RUNTIME_VERSION=CANN-9.1.1
ASCEND_OP_EVAL_WORKER_TOOLCHAIN_VERSION='CANN 9.1.1 / python 3.10 / torch 2.9.0 / torch_npu 2.9.0.post8 / triton_ascend 3.2.0'

# --- Build args for compose rebuilds (defaults live in the Dockerfile ARGs;
#     versions themselves live in pyproject [npu]) ---
# BASE_IMAGE=python:3.11
# Set when torch_npu / triton-ascend are not reachable from PyPI.
PIP_EXTRA_INDEX_URL=

# Admission quotas for ordinary trial, trusted grade and per-session requests.
# ASCEND_OP_EVAL_TRIAL_RATE_LIMIT_PER_MINUTE=60
# ASCEND_OP_EVAL_TRUSTED_RATE_LIMIT_PER_MINUTE=60
# ASCEND_OP_EVAL_TRIAL_MAX_INFLIGHT=4
# ASCEND_OP_EVAL_TRUSTED_MAX_INFLIGHT=4
# ASCEND_OP_EVAL_SESSION_MAX_INFLIGHT=2

# Rollout traffic class: server-declared RL callers (JSON list of caller_id).
# ASCEND_OP_EVAL_ROLLOUT_CALLER_IDS='["rl-runner-1"]'
# ASCEND_OP_EVAL_ROLLOUT_RATE_LIMIT_PER_MINUTE=600
# ASCEND_OP_EVAL_ROLLOUT_MAX_INFLIGHT=256
# Note: rollout callers still share the per-session inflight cap
# (ASCEND_OP_EVAL_SESSION_MAX_INFLIGHT, default 2) — give each concurrent
# rollout step its own X-Session-ID or submissions hit 413 limit_exceeded.

# Card health loop (spec §10): poison quarantine threshold + claim affinity.
# ASCEND_OP_EVAL_POISON_DEATH_THRESHOLD=2
# ASCEND_OP_EVAL_CARD_AFFINITY_AVOIDANCE=true

# Canary + recovery ladder (spec §10). Reset command is site-specific; "{card}"
# is substituted. Max step: 1=cleanup, 2=+device reset, 3=+process restart.
# ASCEND_OP_EVAL_CANARY_BUDGET_SECONDS=120
# ASCEND_OP_EVAL_CANARY_INTERVAL_SECONDS=60
# ASCEND_OP_EVAL_CARD_RESET_COMMAND=
# ASCEND_OP_EVAL_CARD_RECOVERY_MAX_STEP=2
# ASCEND_OP_EVAL_CARD_RECOVERY_RETRY_SECONDS=300
# ASCEND_OP_EVAL_CARD_CANARY_ON_STARTUP=true

# Syntax/import precheck cache; successful evaluations still execute on the NPU.
# ASCEND_OP_EVAL_VERDICT_CACHE_ENABLED=true
# ASCEND_OP_EVAL_VERDICT_CACHE_TTL_SECONDS=604800
# ASCEND_OP_EVAL_PRECHECK_BUDGET_SECONDS=60
# CANN version fingerprint (invalidates cached verdicts on toolchain upgrades):
# Empty disables reuse; populate with the actual deployed CANN identity.
ASCEND_OP_EVAL_CANN_FINGERPRINT=
