// Small scalar AscendC kernels for service integration tests, not tuning baselines.
#include "kernel_operator.h"

extern "C" __global__ __vector__ void native_add(GM_ADDR a, GM_ADDR b, GM_ADDR c,
                                                uint32_t n) {
    AscendC::GlobalTensor<float> x, y, z;
    x.SetGlobalBuffer((__gm__ float*)a, n);
    y.SetGlobalBuffer((__gm__ float*)b, n);
    z.SetGlobalBuffer((__gm__ float*)c, n);
    for (uint32_t i = AscendC::GetBlockIdx(); i < n; i += AscendC::GetBlockNum()) {
        float value = x.GetValue(i) + y.GetValue(i);
#ifdef NATIVE_WRONG
        value += 1.0f;
#endif
        z.SetValue(i, value);
    }
}

extern "C" __global__ __vector__ void native_reduce_sum(GM_ADDR a, GM_ADDR b,
                                                       uint32_t n) {
    AscendC::GlobalTensor<float> x, y;
    x.SetGlobalBuffer((__gm__ float*)a, n);
    y.SetGlobalBuffer((__gm__ float*)b, 1);
    float sum = 0.0f;
    for (uint32_t i = 0; i < n; ++i) sum += x.GetValue(i);
    y.SetValue(0, sum);
}

extern "C" __global__ __vector__ void native_matmul(GM_ADDR a, GM_ADDR b, GM_ADDR c,
                                                   uint32_t m, uint32_t k, uint32_t n) {
    AscendC::GlobalTensor<float> x, y, z;
    x.SetGlobalBuffer((__gm__ float*)a, m * k);
    y.SetGlobalBuffer((__gm__ float*)b, k * n);
    z.SetGlobalBuffer((__gm__ float*)c, m * n);
    for (uint32_t i = AscendC::GetBlockIdx(); i < m * n; i += AscendC::GetBlockNum()) {
        float sum = 0.0f;
        for (uint32_t j = 0; j < k; ++j)
            sum += x.GetValue((i / n) * k + j) * y.GetValue(j * n + i % n);
        z.SetValue(i, sum);
    }
}
