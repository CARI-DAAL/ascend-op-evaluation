# triton-eval:a3-2.0-t360 — cannbench-a3-2.0 overlay build for host A3 (80.5.5.102).
#
# Recipe per A2 handoff (experiments/notes/handoff-20261106.md §1):
#   base = this host's service image + COPY branch triton_evaluation + scripts,
#   triton-ascend aligned to the official runner (3.6.0, cp312 aarch64 wheel from
#   https://repo.huaweicloud.com/ascend/repos/pypi/triton-ascend/).
#
# Differences vs A2's Dockerfile.t360 (their base = triton-eval:910b-ops, py3.10
# full stack): A3's base triton-eval:local is vllm-ascend-derived with the full
# stack on python3.12, so the wheel is cp312 and the release-manifest dependency
# pins (fastapi/uvicorn/redis/rfc8785) are installed here — the 2-month-old base
# predates them and startup release verification compares installed vs declared.
#
# Build from the repository root:
#   docker build -f deploy-a3/Dockerfile.t360 -t triton-eval:a3-2.0-t360 .

FROM triton-eval:local

# --- purge the base's 2-month-old checkout before overlaying ---
# COPY merges into existing directories; the base's /opt/triton-eval carries the
# old package layout (broker.py, worker.py, ... at package top level), and those
# stale modules would poison the release source digest — startup refuses with
# source-digest-mismatch when the installed tree digests differently from the
# manifest. Everything the entrypoint needs is COPY'd fresh below.
RUN rm -rf /opt/triton-eval

# --- branch source overlay (release manifest digests exactly these bytes) ---
COPY pyproject.toml ./
COPY triton_evaluation ./triton_evaluation
COPY scripts ./scripts
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

# --- register current distribution metadata + align declared runtime pins ---
# Base image carries fastapi 0.123.10 / uvicorn 0.49.0 and no redis/rfc8785;
# release startup compares installed versions against the manifest pins.
# Offline install from pre-downloaded pure-python wheels (build containers
# cannot use the corporate proxy, and direct egress is intercepted); all
# transitive requirements are already satisfied by the base image, so --no-deps
# also guards against pip bumping pydantic off its pinned 2.13.4.
COPY deploy-a3/wheels/pins /tmp/pins/
# --no-build-isolation: the build container has no proxy and direct egress is
# intercepted, so pip must not fetch setuptools for build isolation.
RUN pip3 install --no-deps --no-build-isolation . \
 && pip3 install --no-cache-dir --no-deps --no-index --find-links /tmp/pins \
      fastapi==0.139.2 uvicorn==0.51.0 redis==8.0.1 rfc8785==0.1.4 \
 && rm -rf /tmp/pins

# --- triton-ascend 3.6.0 (official-runner alignment) ---
# Same swap sequence as the cannbench runner image: remove both dists, purge
# leftover module dirs, force-install the wheel, assert the landed version.
COPY deploy-a3/wheels/triton_ascend-3.6.0-*.whl /tmp/t360/
RUN pip3 uninstall -y triton triton-ascend 2>/dev/null || true; \
    rm -rf /usr/local/lib/python3.12/site-packages/triton \
           /usr/local/lib/python3.12/site-packages/triton-*dist-info; \
    pip3 install --no-cache-dir --no-deps --force-reinstall \
      /tmp/t360/triton_ascend-3.6.0-*.whl \
 && rm -rf /tmp/t360 \
 && TORCH_DEVICE_BACKEND_AUTOLOAD=0 python3 -c "import importlib.metadata as md; v = md.version('triton-ascend'); assert v == '3.6.0', v; pins = {'fastapi': '0.139.2', 'uvicorn': '0.51.0', 'redis': '8.0.1', 'rfc8785': '0.1.4', 'pydantic': '2.13.4', 'pydantic-settings': '2.14.2'}; bad = {n: md.version(n) for n, w in pins.items() if md.version(n) != w}; assert not bad, bad; print('t360 overlay ok: triton-ascend', v)"
